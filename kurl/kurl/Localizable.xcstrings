          }
        }
      }
    },
    "지금 떠오른 생각을 짧게 남겨 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jot down what's on your mind"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो मन में है उसे छोटा-सा लिखें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま考えていることを短く残してみましょう"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại điều bạn đang nghĩ"
          }
        }
