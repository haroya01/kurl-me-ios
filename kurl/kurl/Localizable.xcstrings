        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事別パフォーマンス"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiệu quả từng bài"
          }
        }
      }
    },
    "글쓰기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "執筆"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết"
          }
        }
      }
    },
    "글에서 태그를 구독하면 그 주제의 새 글이 팔로잉에 모여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to a tag from a post, and new posts on that topic gather in Following."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी पोस्ट से टैग सब्सक्राइब करें, और उस विषय की नई पोस्ट फ़ॉलोइंग में इकट्ठा होंगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿からタグを購読すると、そのトピックの新しい投稿がフォロー中に集まります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký một thẻ từ bài viết, và các bài mới về chủ đề đó sẽ tụ về Đang theo dõi."
          }
        }
      }
    },
    "글은 남지만 공개 주소가 닫혀 아무도 볼 수 없게 돼요. 언제든 다시 발행할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post stays, but its public address closes so no one can see it. You can publish it again anytime."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट रहेगी, लेकिन उसका सार्वजनिक पता बंद हो जाएगा ताकि कोई उसे न देख सके। आप इसे कभी भी दोबारा प्रकाशित कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事は残りますが、公開アドレスが閉じて誰も見られなくなります。いつでも再公開できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài viết vẫn còn, nhưng địa chỉ công khai sẽ đóng lại nên không ai xem được. Bạn có thể đăng lại bất cứ lúc nào."
          }
        }
      }
    },
    "글을 삭제하지 못했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t delete the post"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट हटाई नहीं जा सकी"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事を削除できませんでした"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa bài viết"
          }
        }
      }
    },
    "글을 삭제했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post deleted"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट हटा दी गई"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事を削除しました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa bài viết"
          }
        }
      }
    },
    "글을 쓰려면 로그인하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to write"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखने के लिए साइन इन करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書くにはログインしてください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để viết"
          }
        }
      }
    },
    "글을 쓰면 여기에서 발행 후 모습을 미리 볼 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write something and preview how it will look once published."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ लिखें और प्रकाशित होने के बाद का रूप यहाँ देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文を書くと、公開後の見た目をここでプレビューできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết nội dung để xem trước giao diện sau khi xuất bản."
          }
        }
      }
    },
    "글을 읽다 마음에 닿는 것을 주제로 이어 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect what resonates as you read, by theme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ते हुए जो दिल को छुए, उसे विषय के अनुसार जोड़ें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みながら心に響いたものをテーマでつないでみましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đọc, hãy kết nối những điều chạm đến bạn theo chủ đề."
          }
        }
      }
    },
    "글을 읽다 마음에 닿는 문장을 길게 눌러 하이라이트해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While reading, press and hold a sentence that resonates to highlight it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ते हुए जो वाक्य दिल को छुए, उसे देर तक दबाकर हाइलाइट करें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読んでいて心に響いた文を長押しするとハイライトできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đọc, hãy nhấn giữ câu chạm đến bạn để tô sáng."
          }
        }
      }
    },
    "글을 읽다 우하단 연결 버튼으로 이 컬렉션에 이어 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the connect button while reading to add to this collection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ते हुए नीचे-दाएँ कनेक्ट बटन से इस कलेक्शन में जोड़ें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みながら右下の接続ボタンでこのコレクションに追加しましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đọc, dùng nút kết nối ở góc dưới phải để thêm vào bộ sưu tập này."
          }
        }
      }
    },
    "글을 읽으면 여기에 기록돼요. 기록은 나만 봅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts you read are logged here. Only you can see this."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ी गई पोस्ट यहाँ दर्ज होती हैं. यह रिकॉर्ड केवल आप देख सकते हैं."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読んだ記事はここに記録されます。記録はあなただけが見られます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn đọc bài, nó được ghi lại ở đây. Chỉ mình bạn xem được."
          }
        }
      }
    },
