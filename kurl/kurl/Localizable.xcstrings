        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cập nhật lượt thích"
          }
        }
      }
    },
    "주고받기를 모두 끊고, 그 서버 노트를 어디서도 보이지 않게 해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuts it off entirely and hides its notes everywhere."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारा लेन-देन बंद करता है और उसके नोट कहीं नहीं दिखाता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やり取りをすべて断ち、そのサーバーのノートをどこにも表示しません。"
