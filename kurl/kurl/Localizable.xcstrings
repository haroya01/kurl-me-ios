          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã bị đăng xuất — đăng nhập lại để tiếp tục lưu"
          }
        }
      }
    },
    "로그인이 필요합니다": {
      "localizations": {
