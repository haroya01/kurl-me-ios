    "글이나 하이라이트에서 \"컬렉션에 잇기\"로 이 컬렉션에 이어 채워요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill it by choosing \"Add to collection\" from a post or highlight."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी पोस्ट या हाइलाइट से \"संग्रह में जोड़ें\" चुनकर इसे भरें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事やハイライトから「コレクションに追加」で、このコレクションに加えて埋めましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấp đầy bằng cách chọn \"Thêm vào bộ sưu tập\" từ một bài viết hoặc đoạn tô sáng."
          }
