          }
        }
      }
    },
    "모두에게 공개된 하이라이트": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight visible to everyone"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी को दिखने वाला हाइलाइट"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員に公開されたハイライト"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu hiển thị với mọi người"
          }
        }
      }
    },
    "이 하이라이트를 지울까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this highlight?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह हाइलाइट हटाएँ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このハイライトを削除しますか?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa đánh dấu này?"
          }
        }
      }
    },
    "남긴 공개 메모와 답글도 함께 사라져요. 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its public note and replies go with it. This can't be undone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका सार्वजनिक नोट और जवाब भी हट जाएँगे। इसे वापस नहीं किया जा सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開メモと返信も一緒に消えます。元に戻せません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú công khai và các phản hồi cũng sẽ bị xóa. Không thể hoàn tác."
          }
        }
      }
    },
    "하이라이트를 지웠어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight removed"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाइलाइट हटा दिया गया"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライトを削除しました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa đánh dấu"
          }
        }
      }
    },
    "지우지 못했어요. 다시 시도해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't remove it. Please try again"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाया नहीं जा सका। फिर से कोशिश करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除できませんでした。もう一度お試しください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xóa được. Vui lòng thử lại"
          }
        }
      }
    },
    "하이라이트한 문장을 탭하면 누가 그었는지와 대화를 볼 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a highlighted sentence to see who marked it and the conversation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाइलाइट किए गए वाक्य पर टैप करें और देखें किसने चिह्नित किया और बातचीत"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライトされた文をタップすると、誰が引いたかと会話を見られます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào câu đã đánh dấu để xem ai đánh dấu và cuộc trò chuyện"
          }
        }
      }
    },
    "문장을 길게 눌러 하이라이트하거나 공개 메모를 남겨요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a sentence to highlight it or leave a public note"
          }
        },
        "hi": {
          "stringUnit": {
