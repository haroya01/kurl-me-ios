            "value": "यह नहीं हो सका"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理できませんでした"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thực hiện"
          }
        }
      }
    },
    "최근 가져오기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent imports"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल के इम्पोर्ट"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のインポート"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần nhập gần đây"
          }
        }
      }
    },
    "최신 노트 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See latest notes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम नोट देखें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のノートを見る"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem ghi chú mới nhất"
          }
        }
      }
    },
    "최신·다른 서버·인기에 고른 언어의 노트만 보여요. 언어를 정하지 않은 노트와 팔로잉·리스트는 그대로예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest, other servers and Trending show only notes in the languages you chose. Notes with no language, Following and lists stay as they are."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम, दूसरे सर्वर और ट्रेंडिंग में सिर्फ़ चुनी गई भाषाओं के नोट दिखते हैं। बिना भाषा वाले नोट, फ़ॉलोइंग और सूचियाँ वैसी ही रहती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新・ほかのサーバー・人気には選んだ言語のノートだけが表示されます。言語のないノートとフォロー中・リストはそのままです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mới nhất, máy chủ khác và Thịnh hành chỉ hiện ghi chú bằng ngôn ngữ bạn chọn. Ghi chú không có ngôn ngữ, Đang theo dõi và danh sách vẫn như cũ."
          }
        }
      }
    },
    "최신·인기·태그": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest, trending, tags"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम, ट्रेंडिंग, टैग"
