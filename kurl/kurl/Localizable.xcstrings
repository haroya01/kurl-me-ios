        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव पाने के लिए साइन इन करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを受け取るにはログインしてください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để nhận gợi ý"
          }
        }
      }
    },
    "추천을 지우지 못했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't remove the suggestion"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव हटाया नहीं जा सका"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを消せませんでした"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xoá gợi ý"
          }
        }
      }
    },
    "컬렉션에 연결하려면 로그인하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to connect to a collection"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रह से जोड़ने के लिए साइन इन करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションにつなぐにはログインしてください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để kết nối vào bộ sưu tập"
          }
        }
      }
    },
    "켜면 새 팔로워는 요청을 보내고, 내가 승인해야 팔로워가 돼요. 다른 서버 계정도 같아요. 지금 팔로워는 그대로예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New followers send a request and become followers once you approve. The same goes for accounts on other servers. Your current followers stay."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू करने पर नए फ़ॉलोअर अनुरोध भेजेंगे और आपकी मंज़ूरी के बाद फ़ॉलोअर बनेंगे। दूसरे सर्वर के खातों पर भी यही लागू होता है। मौजूदा फ़ॉलोअर बने रहेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、新しいフォロワーはリクエストを送り、あなたが承認するとフォロワーになります。他のサーバーのアカウントも同じです。今のフォロワーはそのままです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, người theo dõi mới sẽ gửi yêu cầu và chỉ trở thành người theo dõi khi bạn chấp nhận. Tài khoản ở máy chủ khác cũng vậy. Người theo dõi hiện tại vẫn giữ nguyên."
          }
        }
      }
    },
