        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt"
          }
        }
      }
    },
    "끄면 \"고양이\"가 \"고양이가\"에도 걸려요. 한국어는 조사가 붙어서 꺼 두는 편이 맞아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off, \"cat\" also matches \"cats\". Keep it off for languages that attach particles to words, like Korean."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर \"cat\" \"cats\" से भी मेल खाता है। कोरियाई जैसी भाषाओं के लिए इसे बंद रखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフだと「猫」は「猫が」にも一致します。助詞が付く言語ではオフが向いています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, \"cat\" cũng khớp \"cats\". Nên tắt với ngôn ngữ gắn tiểu từ như tiếng Hàn."
          }
        }
      }
    },
    "끄면 기다리던 팔로우 요청이 모두 승인돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning this off approves every pending follow request."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे बंद करने पर सभी लंबित फ़ॉलो अनुरोध मंज़ूर हो जाएंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、待っているフォローリクエストはすべて承認されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt đi thì mọi yêu cầu theo dõi đang chờ sẽ được chấp nhận."
          }
        }
      }
    },
    "끈 종류는 벨과 푸시에 오지 않아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned-off types won't appear in the bell or push"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद किए गए प्रकार घंटी और पुश में नहीं आएंगे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにした種類はベルとプッシュに届きません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại đã tắt sẽ không xuất hiện ở chuông và thông báo đẩy"
          }
        }
      }
    },
    "끝남": {
