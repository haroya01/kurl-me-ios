            "value": "इस जवाब को थ्रेड से हटाएँ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この返信をスレッドから削除しますか?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa trả lời này khỏi chuỗi?"
          }
        }
      }
    },
    "이 스레드에는 답글을 달 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies are closed on this thread"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस थ्रेड पर जवाब नहीं दिया जा सकता"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスレッドには返信できません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể trả lời trong chuỗi này"
          }
        }
