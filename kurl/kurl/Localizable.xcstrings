    "글·댓글·노트가 보이지 않아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their posts, comments and notes are hidden."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनकी पोस्ट, टिप्पणियाँ और नोट्स छिपे हुए हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事・コメント・ノートは表示されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài viết, bình luận và ghi chú của họ bị ẩn."
          }
        }
      }
    },
    "글·시리즈·댓글이 모두 삭제 대상이 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts, series and comments will all be deleted."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पोस्ट, सीरीज़ और टिप्पणियाँ सभी हटा दी जाएँगी."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事・シリーズ・コメントがすべて削除対象になります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài viết, series và bình luận của bạn đều sẽ bị xóa."
          }
        }
      }
    },
    "글과 그 안의 내용이 영구히 지워져요. 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post and everything in it will be permanently erased. This can’t be undone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट और उसकी सारी सामग्री स्थायी रूप से मिट जाएगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事とその中身が完全に削除されます。元に戻せません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài viết và mọi nội dung trong đó sẽ bị xóa vĩnh viễn. Không thể hoàn tác."
          }
        }
      }
    },
