        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल लेखक द्वारा उल्लिखित लोग जवाब दे सकते हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成者がメンションした人だけが返信できます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người được tác giả nhắc đến mới có thể trả lời"
