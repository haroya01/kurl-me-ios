          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kết thúc"
          }
        }
      }
    },
    "마스토돈 같은 다른 서버 계정이 나를 팔로우할 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an account on another server, like Mastodon, follows you"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Mastodon जैसे दूसरे सर्वर का कोई खाता आपको फ़ॉलो करे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastodonなど他のサーバーのアカウントがあなたをフォローしたとき"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một tài khoản ở máy chủ khác, như Mastodon, theo dõi bạn"
          }
        }
      }
    },
    "마스토돈과 같은 CSV 파일이라, 다른 서버의 가져오기에 그대로 올릴 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastodon-compatible CSV files, ready to upload to another server's import."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastodon जैसी CSV फ़ाइलें, जिन्हें दूसरे सर्वर के इम्पोर्ट में सीधे अपलोड कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastodonと同じCSVファイルなので、他のサーバーのインポートにそのまま使えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp CSV giống Mastodon, có thể tải thẳng lên phần nhập của máy chủ khác."
          }
        }
      }
    },
    "마음에 든 노트를 리포스트하면 여기에 모여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes you repost gather here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो नोट आप रीपोस्ट करेंगे, वे यहाँ दिखेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポストしたノートがここに集まります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những ghi chú bạn đăng lại sẽ hiện ở đây."
          }
        }
      }
    },
    "만든 지 30일이 안 된 계정": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts created less than 30 days ago"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "30 दिन से कम पुराने खाते"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成から30日未満のアカウント"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản tạo chưa đến 30 ngày"
          }
        }
      }
    },
    "만들고 담기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create and add"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बनाएँ और जोड़ें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作って追加"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo và thêm"
          }
        }
      }
    },
    "멘션한 사람만": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentioned people only"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उल्लिखित लोग"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンションした人のみ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người được nhắc đến"
          }
        }
      }
    },
    "멘션한 회원만 볼 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only mentioned members can see it"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उल्लिखित सदस्य देख सकते हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンションしたメンバーだけが見られます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thành viên được nhắc đến mới xem được"
          }
        }
      }
    },
    "모두 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See all"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी देखें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて表示"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem tất cả"
          }
        }
      }
    },
    "모든 노트와 인기에 고른 언어의 노트만 보여요. 언어를 정하지 않은 노트와 팔로잉·리스트는 그대로예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All notes and Trending show only notes in the languages you pick. Notes without a language, Following and lists stay as they are."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी नोट और ट्रेंडिंग में सिर्फ़ चुनी गई भाषाओं के नोट दिखेंगे। बिना भाषा वाले नोट, फ़ॉलो किए गए और सूचियाँ जैसी हैं वैसी रहेंगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのノートと人気には選んだ言語のノートだけが表示されます。言語が決まっていないノートとフォロー中・リストはそのままです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả ghi chú và Thịnh hành chỉ hiện ghi chú bằng ngôn ngữ bạn chọn. Ghi chú không có ngôn ngữ, Đang theo dõi và danh sách vẫn như cũ."
          }
        }
      }
    },
