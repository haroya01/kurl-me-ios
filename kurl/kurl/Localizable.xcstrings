    "링크 복사": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy link"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक कॉपी करें"
          }
        },
        "ja": {
