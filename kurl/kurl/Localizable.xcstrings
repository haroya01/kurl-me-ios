          }
        }
      }
    },
    "제한": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn"
          }
        }
      }
    },
    "제한으로 낮추기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower to limit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित तक घटाएँ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限に下げる"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạ xuống giới hạn"
          }
        }
      }
    },
    "제한하면 그 서버 노트가 인기·태그에서 빠지고, 팔로우하지 않은 회원에게는 알림이 가지 않아요. 정지하면 주고받기를 모두 끊고 그 서버 노트를 어디서도 보이지 않게 해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiting keeps a server's notes out of trending and tags, and members who don't follow its accounts get no notices from it. Suspending cuts it off entirely and hides its notes everywhere."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित करने पर उस सर्वर के नोट ट्रेंडिंग और टैग से हट जाते हैं, और जो सदस्य उसे फ़ॉलो नहीं करते उन्हें उससे सूचनाएँ नहीं मिलतीं। निलंबित करने पर सारा लेन-देन बंद हो जाता है और उसके नोट कहीं नहीं दिखते।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限するとそのサーバーのノートはトレンドとタグから外れ、フォローしていないメンバーには通知が届きません。停止するとやり取りをすべて断ち、そのサーバーのノートをどこにも表示しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn khiến ghi chú của máy chủ đó không xuất hiện ở xu hướng và thẻ, và thành viên không theo dõi sẽ không nhận thông báo từ nó. Đình chỉ cắt mọi trao đổi và ẩn ghi chú của nó ở mọi nơi."
          }
        }
      }
    },
    "조용한 공개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet public"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत सार्वजनिक"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひかえめな公開"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công khai lặng lẽ"
          }
        }
      }
    },
    "종을 켠 사람의 새 노트": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New notes from people with the bell on"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिनकी घंटी चालू है उनके नए नोट"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベルをオンにした人の新しいノート"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú mới từ người bạn bật chuông"
          }
        }
      }
    },
    "좋아요를 누르려면 로그인하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to like"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंद करने के लिए साइन इन करें"
          }
        },
        "ja": {
          "stringUnit": {
