    "쓴 글과 시리즈, 분석이 여기 모여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts, series, and analytics collect here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पोस्ट, श्रृंखला और विश्लेषण यहाँ जमा होते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いた記事やシリーズ、分析がここに集まります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài viết, loạt bài và phân tích của bạn sẽ gom về đây."
          }
        }
      }
    },
    "쓴 내용이 새 글 본문으로 옮겨져요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you wrote becomes the body of a new post."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो लिखा वह नई पोस्ट का मुख्य भाग बन जाएगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いた内容が新しい記事の本文に移ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung bạn đã viết sẽ thành phần thân của bài mới."
          }
        }
      }
    },
    "쓴 내용이 새 글 본문으로 옮겨져요. 사진과 투표는 옮겨지지 않아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you wrote becomes the body of a new post. Photos and polls don't move."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो लिखा वह नई पोस्ट का मुख्य भाग बन जाएगा। फ़ोटो और पोल नहीं जाएँगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いた内容が新しい記事の本文に移ります。写真と投票は移りません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung bạn đã viết sẽ thành phần thân của bài mới. Ảnh và bình chọn không được chuyển."
          }
        }
      }
    },
    "아이디@서버 모양으로 적어 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write it as name@server"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे नाम@सर्वर के रूप में लिखें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ID@サーバーの形で入力してください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy viết theo dạng tên@máy chủ"
          }
        }
      }
    },
    "아직 리스트가 없어요. 아래에서 만들어 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No lists yet. Make one below."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई सूची नहीं। नीचे बनाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだリストがありません。下で作ってみましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có danh sách. Hãy tạo ở bên dưới."
          }
        }
      }
    },
    "아직 리포스트가 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reposts yet"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई रीपोस्ट नहीं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだリポストはありません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có lượt đăng lại"
          }
        }
      }
    },
    "아직 받은 다른 서버 노트가 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notes from other servers yet"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी दूसरे सर्वर से कोई नोट नहीं मिला"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバーのノートはまだありません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa nhận ghi chú nào từ máy chủ khác"
          }
        }
      }
    },
    "아직 이 노트를 인용한 노트나 글이 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notes or posts have quoted this note yet"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक किसी नोट या पोस्ट ने इस नोट को उद्धृत नहीं किया"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだこのノートを引用したノートや記事はありません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ghi chú hay bài viết nào trích dẫn ghi chú này"
          }
        }
      }
    },
    "아직 이 링크를 실은 노트가 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notes carry this link yet"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लिंक वाला कोई नोट अभी नहीं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを載せたノートはまだありません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ghi chú nào chứa liên kết này"
          }
        }
      }
    },
    "알림 %lld개": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notification"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld notifications"
                }
              }
            }
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld सूचनाएँ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知%lld件"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld thông báo"
          }
        }
      }
    },
    "알림 거르기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification filtering"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना फ़िल्टर"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知のフィルター"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọc thông báo"
          }
        }
      }
    },
    "알림 거르기가 따로 둔 알림이에요. 받으면 그 사람의 알림이 목록에 들어오고 앞으로도 와요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications your filters set aside. Accept someone to move theirs into your notifications and keep them coming."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये वे सूचनाएँ हैं जिन्हें फ़िल्टर ने अलग रखा। किसी को स्वीकार करने पर उनकी सूचनाएँ सूची में आ जाएँगी और आगे भी आती रहेंगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知のフィルターが分けておいた通知です。受け取ると、その人の通知が一覧に入り、この先も届きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là thông báo bộ lọc đã để riêng. Chấp nhận ai đó để đưa thông báo của họ vào danh sách và tiếp tục nhận."
          }
        }
      }
    },
    "알림 설정을 바꾸지 못했습니다": {
      "localizations": {
