    "로그인 응답을 처리하지 못했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't process the sign-in response."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन-इन प्रतिक्रिया संसाधित नहीं हो सकी."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン応答を処理できませんでした。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xử lý phản hồi đăng nhập."
          }
        }
      }
    },
    "로그인에 실패했습니다. 다시 시도해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन विफल रहा. कृपया फिर से प्रयास करें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインに失敗しました。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập thất bại. Vui lòng thử lại."
          }
        }
      }
    },
    "로그인이 풀려 저장하지 못했어요 — 다시 로그인한 뒤 시도해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were signed out, so it couldn't be saved — sign in again and retry"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन-आउट होने से सेव नहीं हुआ — फिर साइन इन करके कोशिश करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインが切れて保存できませんでした — 再ログインしてからお試しください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã bị đăng xuất nên không lưu được — hãy đăng nhập lại rồi thử"
          }
        }
      }
    },
    "로그인이 풀려 저장하지 못했어요 — 다시 로그인해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
