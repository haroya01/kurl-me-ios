            "value": "最初の記事を公開すると、ここにカタログとして積み上がります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng bài đầu tiên và nó sẽ xếp vào danh mục này."
