    "나는 나를 더 잘 말하기 위해 남의 문장을 옮긴다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I quote others only to better express myself."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं दूसरों के शब्द केवल इसलिए उद्धृत करता हूँ ताकि स्वयं को बेहतर कह सकूँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は自分をよりよく語るためにのみ、他人の言葉を引く。"
          }
