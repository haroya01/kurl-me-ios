          }
        }
      }
    },
    "차단한 서버의 계정은 팔로우할 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't follow accounts on a server you blocked"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक किए गए सर्वर के खाते फ़ॉलो नहीं किए जा सकते"
          }
        },
        "ja": {
