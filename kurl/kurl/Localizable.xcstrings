    "%@에 있는 계정이에요. 이 계정의 새 노트가 팔로잉 피드에 와요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account lives on %@. Its new notes arrive in your Following feed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह खाता %@ पर है। इसके नए नोट आपकी फ़ॉलोइंग फ़ीड में आते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にあるアカウントです。新しいノートがフォロー中のフィードに届きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này ở %@. Ghi chú mới của tài khoản sẽ đến bảng tin Đang theo dõi."
          }
        }
      }
    },
    "%@에 있는 계정이에요. 팔로우하면 %@에 요청을 보내요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account lives on %1$@. Following sends a request to %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह खाता %1$@ पर है। फ़ॉलो करने पर %2$@ को अनुरोध जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にあるアカウントです。フォローすると%2$@にリクエストを送ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này ở %1$@. Theo dõi sẽ gửi yêu cầu đến %2$@."
          }
        }
      }
    },
