          }
        }
      }
    },
    "일주일 안에 쓴 노트 중 반응을 많이 받은 노트가 먼저 올라와요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes from the past week with the most reactions come first."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले एक हफ़्ते के नोट्स में जिन्हें सबसे ज़्यादा प्रतिक्रिया मिली, वे पहले आते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この一週間に書かれたノートのうち、反応の多いものが先に並びます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú trong tuần qua có nhiều tương tác nhất sẽ hiện trước."
          }
        }
      }
    },
    "작가 페이지에서 종을 켠 사람이 새 노트를 올릴 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone whose bell you turned on posts a new note"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई जिसकी घंटी आपने लेखक पेज पर चालू की है, नया नोट पोस्ट करे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作家ページでベルをオンにした人が新しいノートを投稿したとき"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi người bạn đã bật chuông trên trang tác giả đăng ghi chú mới"
          }
        }
      }
    },
    "작가 페이지의 ⋯ 메뉴에서 뮤트할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can mute someone from the ⋯ menu on their page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किसी के पेज के ⋯ मेनू से म्यूट कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作家ページの ⋯ メニューからミュートできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tắt tiếng từ menu ⋯ trên trang của họ."
          }
        }
      }
    },
    "접기": {
      "localizations": {
        "en": {
