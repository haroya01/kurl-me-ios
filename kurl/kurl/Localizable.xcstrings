    "다른 낱말로 찾아보거나, 피드에서 읽을 글을 둘러보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a different word, or browse posts to read in Feed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई और शब्द आज़माएँ, या फ़ीड में पढ़ने के लिए पोस्ट देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の言葉で探すか、フィードで読む記事を見てみましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử từ khác, hoặc xem các bài để đọc trong Nguồn cấp."
          }
        }
      }
    },
    "다른 서버로 퍼진 사본에도 지우라는 요청을 보내요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll also ask other servers to delete their copies."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम दूसरे सर्वरों से भी उनकी कॉपी हटाने को कहेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバーに広まったコピーにも削除を依頼します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi cũng sẽ yêu cầu các máy chủ khác xóa bản sao."
          }
        }
      }
    },
    "다른 서버에 노트 공유": {
