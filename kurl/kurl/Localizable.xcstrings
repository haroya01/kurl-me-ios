    "팔로워·팔로잉 목록 숨기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide followers and following lists"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
