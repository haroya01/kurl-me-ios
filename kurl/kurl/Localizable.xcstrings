          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mới nhất, thịnh hành, thẻ"
          }
        }
      }
    },
    "추천을 받으려면 로그인하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
