          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không thể theo dõi tài khoản trên máy chủ đã chặn"
          }
        }
      }
    },
    "처리하지 못했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't do that"
          }
        },
        "hi": {
          "stringUnit": {
