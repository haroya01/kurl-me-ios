    "노트를 쓸 때 아래의 \"예약\"으로 올릴 시각을 정할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When writing a note, use \"Schedule\" at the bottom to pick when it posts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट लिखते समय नीचे \"शेड्यूल\" से पोस्ट का समय चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートを書くとき、下の「予約」で投稿日時を決められます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi viết ghi chú, dùng \"Đặt lịch\" ở dưới để chọn thời gian đăng."
          }
        }
      }
    },
    "노트와 프로필에 사용자 이름보다 먼저 보여요. 비우면 사용자 이름이 보여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown before your username on notes and your profile. Leave it empty to show your username."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट और प्रोफ़ाइल पर उपयोगकर्ता नाम से पहले दिखता है। खाली छोड़ें तो उपयोगकर्ता नाम दिखेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートとプロフィールでユーザー名より先に表示されます。空にするとユーザー名が表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị trước tên người dùng trên ghi chú và hồ sơ. Để trống sẽ hiện tên người dùng."
          }
        }
      }
    },
    "노트의 … 메뉴나 상세의 북마크로 모아 둘 수 있어요. 북마크는 나만 봐요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save notes from their … menu or the bookmark in a note's page. Only you see your bookmarks."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट के … मेनू या नोट पेज के बुकमार्क से सहेजें। बुकमार्क सिर्फ़ आप देखते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートの…メニューや詳細のブックマークから保存できます。ブックマークは自分だけが見られます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ghi chú từ menu … hoặc nút đánh dấu trong trang ghi chú. Chỉ bạn thấy đánh dấu của mình."
          }
        }
      }
    },
    "누가 내 노트를 리포스트하거나 다른 서버에서 부스트할 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone reposts your note or boosts it from another server"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपका नोट रीपोस्ट करे या दूसरे सर्वर पर बूस्ट करे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたのノートをリポスト、または他のサーバーでブーストしたとき"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó đăng lại ghi chú của bạn hoặc chia sẻ nó từ máy chủ khác"
          }
        }
      }
    },
    "누가 내 노트를 인용할 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone quotes your note"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपके नोट को उद्धृत करे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたのノートを引用したとき"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó trích dẫn ghi chú của bạn"
          }
        }
      }
    },
    "누가 내 노트를 좋아할 때. 다른 서버의 좋아요도 포함해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone likes your note, including likes from other servers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपका नोट पसंद करे, दूसरे सर्वर की पसंद भी"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたのノートにいいねしたとき。他のサーバーからのいいねも含みます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó thích ghi chú của bạn, kể cả từ máy chủ khác"
          }
        }
      }
    },
    "누가 내 노트에 답글을 남길 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone replies to your note"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपके नोट का जवाब दे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたのノートに返信したとき"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó trả lời ghi chú của bạn"
          }
        }
      }
    },
    "누가 노트에서 나를 언급할 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone mentions you in a note"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई नोट में आपका ज़िक्र करे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがノートであなたをメンションしたとき"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ai đó nhắc đến bạn trong ghi chú"
          }
        }
      }
    },
    "누구나 볼 수 있지만 최신·인기·태그에는 안 나와요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can see it, but it stays out of Latest, Trending and tags"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी देख सकता है, पर यह नवीनतम, ट्रेंडिंग और टैग में नहीं दिखेगा"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰でも見られますが、最新・人気・タグには出ません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai cũng xem được, nhưng không hiện ở Mới nhất, Thịnh hành và thẻ"
          }
        }
      }
    },
    "누르면 맨 위로, 길게 누르면 피드 고르기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to go to the top, touch and hold to choose a feed"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर जाने के लिए टैप करें, फ़ीड चुनने के लिए दबाकर रखें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで先頭へ、長押しでフィードを選ぶ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để lên đầu trang, chạm và giữ để chọn bảng tin"
          }
        }
      }
    },
    "다른 기기에서 고친 글이라 저장하지 않았어요. 다시 열면 이어 쓸 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This post was edited on another device, so it wasn't saved. Open it again to keep writing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पोस्ट किसी दूसरे डिवाइस पर बदली गई थी, इसलिए सेव नहीं हुई। दोबारा खोलकर लिखना जारी रखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の端末で編集された記事なので保存しませんでした。開き直すと続きから書けます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài viết đã được sửa trên thiết bị khác nên chưa được lưu. Mở lại để viết tiếp."
          }
        }
      }
    },
    "다른 기기에서 이 글을 고쳤어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This post was edited on another device"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पोस्ट किसी दूसरे डिवाइस पर बदली गई"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の端末でこの記事が編集されました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài viết này đã được sửa trên thiết bị khác"
          }
        }
      }
    },
    "다른 마스토돈 서버에서 내보낸 파일을 올리면 지금 것에 더해요. 이 서버 회원과 다른 서버 계정 팔로우, 이 서버 회원 차단·뮤트·리스트, 차단한 서버, 북마크를 옮길 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload a file exported from another Mastodon server to add it to what you have. You can bring follows of members here and accounts elsewhere, blocks, mutes and lists of members here, blocked servers, and bookmarks."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे Mastodon सर्वर से निर्यात की गई फ़ाइल अपलोड करें, वह आपके मौजूदा डेटा में जुड़ जाएगी। यहाँ के सदस्यों और दूसरे सर्वर के खातों के फ़ॉलो, यहाँ के सदस्यों के ब्लॉक·म्यूट·सूचियाँ, ब्लॉक किए गए सर्वर और बुकमार्क ला सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のMastodonサーバーからエクスポートしたファイルをアップロードすると、今のものに追加されます。このサーバーの会員と他のサーバーのアカウントのフォロー、このサーバーの会員のブロック・ミュート・リスト、ブロックしたサーバー、ブックマークを移せます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lên tệp xuất từ máy chủ Mastodon khác để thêm vào dữ liệu hiện có. Bạn có thể chuyển lượt theo dõi thành viên ở đây và tài khoản nơi khác, chặn·tắt tiếng·danh sách thành viên ở đây, máy chủ đã chặn và dấu trang."
          }
        }
      }
    },
    "다른 서버": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other servers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे सर्वर"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバー"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ khác"
          }
        }
      }
    },
    "다른 서버 계정 화면의 ⋯ 메뉴에서 그 서버 전체를 차단할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can block a whole server from the ⋯ menu on an account from that server."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे सर्वर के खाते के ⋯ मेनू से आप पूरा सर्वर ब्लॉक कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のサーバーのアカウント画面の⋯メニューから、そのサーバー全体をブロックできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chặn cả máy chủ từ menu ⋯ trên trang tài khoản của máy chủ đó."
          }
        }
      }
    },
    "다른 서버 전체를 제한하거나 정지할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can limit or suspend whole servers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पूरे सर्वर को सीमित या निलंबित कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー全体を制限または停止できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể giới hạn hoặc đình chỉ cả một máy chủ."
          }
        }
      }
    },
    "다른 서버 팔로잉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following elsewhere"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे सर्वर पर फ़ॉलोइंग"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバーでフォロー中"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang theo dõi ở máy chủ khác"
          }
        }
      }
    },
    "다른 서버에서 팔로우하는 계정이 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't follow anyone on other servers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप दूसरे सर्वर पर किसी को फ़ॉलो नहीं करते"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバーでフォローしているアカウントはありません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa theo dõi ai ở máy chủ khác"
          }
        }
      }
    },
    "다른 서버의 노트": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes from other servers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे सर्वर के नोट"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバーのノート"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú từ máy chủ khác"
          }
        }
      }
    },
    "다른 서버의 팔로워": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Followers on other servers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे सर्वर के फ़ॉलोअर"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のサーバーのフォロワー"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người theo dõi ở máy chủ khác"
          }
        }
      }
    },
    "다시 로그인하면 쓰던 글이 이어서 저장돼요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again and your writing keeps saving"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर साइन इन करें, लेखन सेव होता रहेगा"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ログインすると執筆中の記事が引き続き保存されます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập lại để bài viết tiếp tục được lưu"
          }
        }
      }
    },
    "단계": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्तर"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "段階"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức"
          }
        }
      }
    },
    "단어 전체가 맞을 때만": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole word only"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल पूरा शब्द"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語全体が一致するときだけ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khớp cả từ"
          }
        }
      }
    },
    "담은 사람이 없어요. 프로필의 … 메뉴에서 \"리스트에 추가\"를 눌러 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one here yet. Use \"Add to list\" in a profile's … menu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई नहीं। प्रोफ़ाइल के … मेनू से \"सूची में जोड़ें\" चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ誰もいません。プロフィールの…メニューの「リストに追加」を使ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ai. Dùng \"Thêm vào danh sách\" trong menu … của hồ sơ."
          }
        }
      }
    },
    "답글 메뉴": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply menu"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब मेनू"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信メニュー"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu trả lời"
          }
        }
      }
    },
    "답글을 달 노트가 지워졌어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note you were replying to was deleted"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस नोट का जवाब देना था वह हटा दिया गया"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信先のノートが削除されました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú bạn định trả lời đã bị xóa"
          }
        }
      }
    },
    "답글을 달 수 없는 노트예요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't reply to that note"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नोट का जवाब नहीं दिया जा सकता"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信できないノートです"
          }
        },
        "vi": {
          "stringUnit": {
