          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली पोस्ट प्रकाशित करें — वह इस कैटलॉग में जुड़ेगी।"
          }
        },
        "ja": {
          "stringUnit": {
