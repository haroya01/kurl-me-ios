    "로그인하면 리스트에 담은 사람의 노트를 볼 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see notes from the people in your lists."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करें और अपनी सूचियों के लोगों के नोट देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインすると、リストに入れた人のノートを見られます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để xem ghi chú của những người trong danh sách của bạn."
          }
        }
      }
    },
    "로그인하면 멘션한 사람만 보는 노트가 여기 모여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see notes only you and the people they mention can read."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करें ताकि केवल उल्लिखित लोगों वाले नोट यहाँ दिखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインすると、メンションした人だけが見るノートがここに集まります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để xem các ghi chú chỉ người được nhắc đến mới đọc được."
          }
        }
      }
    },
    "로그인하면 북마크한 노트를 여기서 다시 볼 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to come back to the notes you bookmarked."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करें और बुकमार्क किए नोट्स यहाँ दोबारा देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインすると、ブックマークしたノートをここでまた読めます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để xem lại các ghi chú bạn đã đánh dấu."
          }
        }
      }
    },
    "로그인하면 블로그와 노트에서 팔로우한 사람의 노트가 여기 모여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to gather notes from people you follow on the blog and in notes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करें — ब्लॉग और नोट्स में जिन्हें आप फ़ॉलो करते हैं, उनके नोट्स यहाँ आएँगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインすると、ブログとノートでフォローした人のノートがここに集まります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để xem ghi chú của những người bạn theo dõi trên blog và ghi chú."
          }
        }
      }
    },
    "로그인하면 이 서버가 받은 마스토돈 같은 다른 서버의 공개 노트를 볼 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see public notes this server received from other servers like Mastodon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करके देखें कि इस सर्वर को Mastodon जैसे दूसरे सर्वर से कौन से सार्वजनिक नोट मिले।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインすると、このサーバーが受け取ったMastodonなどほかのサーバーの公開ノートを見られます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để xem các ghi chú công khai mà máy chủ này nhận từ các máy chủ khác như Mastodon."
          }
        }
      }
    },
    "로그인하지 않았어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're not signed in"
