    },
    "이름을 바꾸면 30일 동안 다시 바꿀 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you change your name, you can’t change it again for 30 days."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम बदलने के बाद, आप 30 दिनों तक इसे दोबारा नहीं बदल सकते."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を変更すると、30日間は再度変更できません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi đổi tên, bạn không thể đổi lại trong 30 ngày."
          }
        }
      }
    },
    "이미 사용 중인 이름이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name is already taken."
