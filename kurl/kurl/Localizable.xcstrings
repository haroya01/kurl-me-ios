            "value": "Hiện tại"
          }
        }
      }
    },
    "지금 쓴 내용은 이 기기에 보관했어요. 다시 열면 되살릴 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you wrote is kept on this device. Open the post again to bring it back."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका लिखा इस डिवाइस पर रखा गया है। पोस्ट दोबारा खोलकर उसे वापस लाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま書いた内容はこの端末に保管しました。開き直すと復元できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung bạn vừa viết đã được lưu trên thiết bị này. Mở lại bài viết để khôi phục."
          }
        }
      }
    },
    "짧게, 바로 올리기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short, posted right away"
          }
        },
        "hi": {
