            "value": "Kéo tiếp để xem phần tiếp theo"
          }
        }
      }
    },
    "계속 저장하지 못하고 있어요 — 지금 다시 시도해 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still can't save — try again now"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी भी सेव नहीं हो पा रहा — अभी फिर से कोशिश करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できない状態が続いています — 今すぐ再試行してください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn chưa lưu được — hãy thử lại ngay"
          }
        }
      }
    },
    "계속하면 [이용약관](%@)과 [개인정보 처리방침](%@)에 동의하는 것으로 간주됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing, you agree to our [Terms of Service](%@) and [Privacy Policy](%@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने पर आप हमारी [सेवा की शर्तों](%@) और [गोपनीयता नीति](%@) से सहमत होते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行すると[利用規約](%@)と[プライバシーポリシー](%@)に同意したものとみなされます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tiếp tục, bạn đồng ý với [Điều khoản dịch vụ](%@) và [Chính sách bảo mật](%@)."
          }
        }
      }
    },
    "계정": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản"
          }
        }
      }
    },
    "계정 하나면 읽고, 쓰고, 연결한 것이 어디서든 이어져요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One account carries what you read, write, and connect — everywhere."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक खाते से आपका पढ़ा, लिखा और जोड़ा हुआ हर जगह साथ चलता है."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントひとつで、読んだもの・書いたもの・つないだものがどこでも続きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tài khoản giữ mọi thứ bạn đọc, viết và kết nối — ở mọi nơi."
          }
        }
      }
    },
    "계정을 삭제할까요?": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप अपना खाता हटाना चाहते हैं?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除しますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tài khoản của bạn?"
          }
        }
      }
    },
    "계정을 삭제했습니다": {
