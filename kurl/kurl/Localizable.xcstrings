          }
        }
      }
    },
    "작가 블로그": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Author blog"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक ब्लॉग"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作者のブログ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Blog tác giả"
          }
        }
      }
    },
    "작가 이름, 글 제목이나 내용, 태그로 찾아보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by author name, post title or content, or tag."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक के नाम, पोस्ट के शीर्षक या सामग्री, या टैग से खोजें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作者名、記事のタイトルや内容、タグで探せます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm theo tên tác giả, tiêu đề hoặc nội dung bài viết, hoặc thẻ."
          }
        }
      }
    },
    "작가 페이지의 ⋯ 메뉴에서 차단할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can block from the ⋯ menu on the author's page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक पेज के ⋯ मेनू से ब्लॉक कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作者ページの ⋯ メニューからブロックできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chặn từ menu ⋯ trên trang tác giả."
          }
        }
      }
    },
    "작가·글·태그 찾기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search authors, posts, tags"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक, पोस्ट, टैग खोजें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作者・記事・タグを検索"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm tác giả, bài viết, thẻ"
          }
        }
      }
    },
    "작가를 팔로우하면 새 글이 여기 도착해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow writers and their new posts will land here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखकों को फ़ॉलो करें और उनकी नई पोस्ट यहाँ आएँगी."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作家をフォローすると、新しい記事がここに届きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi tác giả và bài mới của họ sẽ đến đây."
          }
        }
      }
    },
    "작가를 팔로우하면, 그들의 글이 이 덱에 흘러요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow writers, and their posts flow into this deck."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखकों को फ़ॉलो करें, और उनकी पोस्ट इस डेक में आती जाएँगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作家をフォローすると、その記事がこのデックに流れます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi tác giả, và bài của họ sẽ chảy vào bộ bài này."
          }
        }
      }
    },
    "작가의 글과 댓글·좋아요·하이라이트가 모두 지워져요. 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The author's post and its comments, likes and highlights will all be deleted. This can't be undone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक की पोस्ट और उसकी टिप्पणियाँ, लाइक, हाइलाइट सब हट जाएँगे। इसे वापस नहीं किया जा सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作者の記事とコメント・いいね・ハイライトがすべて削除されます。元に戻せません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài viết của tác giả cùng bình luận, lượt thích, tô sáng sẽ bị xóa hết. Không thể hoàn tác."
          }
        }
      }
    },
    "작가의 글이 비공개로 내려가요. 글은 남고, 작가가 다시 발행할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The author's post goes private. It remains, and the author can republish it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेखक की पोस्ट निजी हो जाएगी। पोस्ट रहेगी और लेखक फिर प्रकाशित कर सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作者の記事が非公開になります。記事は残り、作者が再公開できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài của tác giả sẽ chuyển sang riêng tư. Bài vẫn còn và tác giả có thể đăng lại."
          }
        }
      }
    },
    "잘못된 요청입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid request."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य अनुरोध."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不正なリクエストです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu không hợp lệ."
          }
        }
      }
    },
    "잠시 후 다시 시도해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again in a moment"
          }
        },
