    "이전 이름은 30일간 예약돼 기존 링크가 바로 깨지지 않아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your old name is reserved for 30 days, so existing links won’t break right away."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराना नाम 30 दिनों के लिए सुरक्षित रहता है, ताकि मौजूदा लिंक तुरंत न टूटें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の名前は30日間予約されるため、既存のリンクがすぐに切れることはありません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên cũ được giữ trong 30 ngày nên liên kết hiện tại không bị hỏng ngay."
          }
        }
      }
