    "제목 없는 초안": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untitled draft"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना शीर्षक का ड्राफ़्ट"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無題の下書き"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản nháp chưa có tiêu đề"
          }
        }
      }
    },
    "제목과 본문, 초안으로 다듬기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title and body, refined as a draft"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक और मुख्य भाग, ड्राफ़्ट में निखारें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルと本文、下書きで仕上げる"
          }
        },
        "vi": {
