    "블로그에서 팔로우한 사람도 함께 보여요. 인기 노트에서 시작해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People you follow on the blog show up here too. Start with trending notes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉग पर जिन्हें आप फ़ॉलो करते हैं, वे भी यहाँ दिखते हैं। ट्रेंडिंग नोट्स से शुरू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブログでフォローした人もここに表示されます。人気のノートから始めてみましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những người bạn theo dõi trên blog cũng hiện ở đây. Hãy bắt đầu với ghi chú thịnh hành."
          }
        }
      }
    },
