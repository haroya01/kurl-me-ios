    },
    "설정의 알림 거르기에서 어떤 알림을 따로 둘지 고를 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which notifications to set aside in Settings › Notification filtering."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग › सूचना फ़िल्टर में चुनें कि कौन-सी सूचनाएँ अलग रखनी हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の「通知のフィルター」で、どの通知を分けておくか選べます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thông báo nào để riêng trong Cài đặt › Lọc thông báo."
          }
        }
      }
    },
