            "value": "リンクをコピー"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép liên kết"
          }
        }
      }
    },
    "링크를 담은 노트는 카드가 붙은 뒤에 여기 모여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes that carry this link gather here once their card is attached."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लिंक वाले नोट, कार्ड जुड़ने के बाद यहाँ इकट्ठा होते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを載せたノートは、カードが付いたあとここに集まります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú chứa liên kết này sẽ tập hợp ở đây khi thẻ được gắn."
          }
        }
      }
    },
    "링크를 복사했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link copied"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक कॉपी हो गया"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクをコピーしました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao chép liên kết"
          }
        }
      }
    },
    "마감됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed"
          }
        },
        "hi": {
