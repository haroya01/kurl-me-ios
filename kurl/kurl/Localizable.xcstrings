          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn danh sách người theo dõi và đang theo dõi"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलोअर्स और फ़ॉलोइंग सूची छिपाएँ"
          }
        }
      }
    },
    "켜면 다른 사람에게 내 팔로워·팔로잉 목록이 보이지 않아요. 수는 원래 나에게만 보여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, others can’t see your followers and following lists. Counts are only ever shown to you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、他の人にはあなたのフォロワー・フォロー中リストが表示されません。数はもともとあなたにだけ表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, người khác sẽ không thấy danh sách người theo dõi và đang theo dõi của bạn. Số lượng vốn chỉ hiển thị với bạn."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर दूसरे लोग आपकी फ़ॉलोअर्स और फ़ॉलोइंग सूची नहीं देख पाएँगे। संख्या हमेशा सिर्फ़ आपको दिखती है।"
          }
        }
      }
    },
