    },
    "팔로우 요청을 취소할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the follow request?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलो अनुरोध रद्द करें?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローリクエストを取り消しますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy yêu cầu theo dõi?"
          }
        }
      }
    },
    "팔로우 직접 승인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve followers manually"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलोअर्स को ख़ुद मंज़ूरी दें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローを手動で承認"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự duyệt người theo dõi"
          }
        }
      }
    },
    "팔로우 추천": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who to follow"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसे फ़ॉलो करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめのアカウント"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý theo dõi"
          }
        }
      }
    },
    "팔로우를 요청했어요. %@이 수락하면 팔로잉이 돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow requested. You'll be following once %@ accepts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलो अनुरोध भेजा। %@ स्वीकार करते ही आप फ़ॉलो करने लगेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローをリクエストしました。%@が承認するとフォロー中になります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi yêu cầu theo dõi. Khi %@ chấp nhận, bạn sẽ theo dõi."
          }
        }
      }
    },
    "팔로우를 요청했어요. 승인되면 팔로잉이 돼요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow requested. You'll be following once they approve"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलो अनुरोध भेजा गया। मंज़ूरी मिलते ही आप फ़ॉलो करने लगेंगे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローをリクエストしました。承認されるとフォロー中になります"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi yêu cầu theo dõi. Khi được chấp nhận, bạn sẽ theo dõi họ"
          }
        }
      }
    },
    "팔로우를 직접 승인하는 계정": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approves followers manually"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलोअर्स को ख़ुद मंज़ूरी देने वाला खाता"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローを手動で承認するアカウント"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản tự duyệt người theo dõi"
          }
        }
      }
    },
    "팔로우를 직접 승인하면 새 팔로워가 여기서 기다려요. 프로필 편집에서 켤 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you approve followers manually, new followers wait here. Turn it on in Edit profile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलोअर्स को ख़ुद मंज़ूरी देने पर नए फ़ॉलोअर यहाँ इंतज़ार करते हैं। इसे प्रोफ़ाइल संपादन में चालू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローを手動で承認すると、新しいフォロワーはここで待ちます。プロフィール編集でオンにできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn tự duyệt người theo dõi, người theo dõi mới sẽ chờ ở đây. Bật trong phần Chỉnh sửa hồ sơ."
          }
        }
      }
    },
    "팔로우를 직접 승인할 때 누군가 팔로우를 요청하면": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone asks to follow you while you approve followers manually"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप फ़ॉलोअर्स को ख़ुद मंज़ूरी देते हों और कोई फ़ॉलो का अनुरोध करे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローを手動で承認しているときに、誰かがフォローをリクエストしたら"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn đang tự duyệt và có người yêu cầu theo dõi"
          }
        }
      }
    },
    "팔로우하는 사람이 생기면 여기 모여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who follow will show up here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलो करने वाले लोग यहाँ दिखेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローする人ができると、ここに集まります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người theo dõi sẽ xuất hiện ở đây."
          }
        }
      }
    },
    "팔로우하려면 로그인하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to follow"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलो करने के लिए साइन इन करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローするにはログインしてください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập để theo dõi"
          }
        }
      }
    },
    "팔로우하면 이 계정이 쓰는 새 노트가 여기와 팔로잉 피드에 와요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow to get this account's new notes here and in your Following feed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलो करें — इस खाते के नए नोट यहाँ और आपकी फ़ॉलोइंग फ़ीड में आएँगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローすると、このアカウントの新しいノートがこことフォロー中のフィードに届きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi để nhận ghi chú mới của tài khoản này ở đây và trong bảng tin Đang theo dõi."
          }
        }
      }
    },
    "팔로우한 사람의 노트가 여기 모여요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes from people you follow show up here"
          }
        },
        "hi": {
