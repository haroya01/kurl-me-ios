    "로그인이 풀렸어요 — 다시 로그인해야 저장돼요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been signed out — sign in again to keep saving"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप साइन-आउट हो गए — सेव जारी रखने के लिए फिर साइन इन करें"
          }
        },
        "ja": {
